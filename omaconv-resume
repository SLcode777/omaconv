#!/bin/sh
# Resume a conversation in its directory, keeping the terminal open when
# claude exits with an error so the message is actually readable.
# usage: omaconv-resume <cwd> <session-id> [--fork]
# Args are positional, never interpolated.

cwd="$1"
id="$2"
fork="$3"

if ! cd -- "$cwd" 2>/dev/null; then
  printf 'omaconv: cannot cd into %s\npress enter to close\n' "$cwd"
  read -r _
  exit 1
fi

if [ "$fork" = "--fork" ]; then
  claude --resume "$id" --fork-session
else
  claude --resume "$id"
fi
status=$?

# 130 = SIGINT (user quit), not an error worth holding the terminal for.
if [ "$status" -ne 0 ] && [ "$status" -ne 130 ]; then
  printf '\nclaude exited with status %s — press enter to close\n' "$status"
  read -r _
fi
exit "$status"
