#!/usr/bin/env python3
"""omaconv-render — render an agent transcript as a readable dialogue.

Keeps only what a human wrote or read: user text and assistant text.
Tool results, thinking blocks, tool calls and command wrappers are noise
and are dropped. Tolerant parsing, stdlib only (PRD §9).

Default: the full dialogue on stdout (used by omaconv-grep).
--preview: every turn as JSON, each clipped, for the palette's preview
pane (its list view only instantiates the visible rows).
--skill: a SKILL.md split into frontmatter and body, as JSON, for the
skills preview pane.
--agent <name>: transcript format (claude by default, codex, opencode,
antigravity or pi).
--session <id>: which session to read (opencode only — its <file> is the
shared SQLite db, not a per-session transcript).
"""

import json
import sqlite3
import sys
from datetime import datetime, timezone

NOISE_PREFIXES = ("<command-", "<local-command", "Caveat:", "<system-reminder",
                  "<task-notification", "[Request interrupted")
CODEX_NOISE = ("<environment_context", "<turn_aborted", "<user_instructions",
               "# Context from my IDE")
OPENCODE_NOISE = ("<system-reminder",)
# Safety cap only: above the longest real turn observed (28k chars), so
# messages are never visibly truncated — it just bounds pathological pastes.
PREVIEW_CLIP = 32000


def message_texts(content):
    if isinstance(content, str):
        return [content]
    out = []
    if isinstance(content, list):
        for item in content:
            if isinstance(item, dict) and item.get("type") == "text":
                text = item.get("text")
                if isinstance(text, str):
                    out.append(text)
    return out


def iter_turns(path):
    """Yield {who, time, text} for each human-visible turn, in file order."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if not isinstance(obj, dict) or obj.get("isMeta"):
                continue
            kind = obj.get("type")
            if kind not in ("user", "assistant"):
                continue
            message = obj.get("message")
            if not isinstance(message, dict):
                continue
            parts = [p for p in message_texts(message.get("content"))
                     if p.strip() and not p.lstrip().startswith(NOISE_PREFIXES)]
            if not parts:
                continue
            stamp = obj.get("timestamp")
            when = stamp[:16].replace("T", " ") if isinstance(stamp, str) else ""
            yield {"who": "you" if kind == "user" else "claude",
                   "time": when,
                   "text": "\n".join(p.rstrip() for p in parts)}


def iter_codex_turns(path):
    """Same shape as iter_turns, for Codex rollout files: {timestamp,
    type, payload} lines, dialogue in response_item messages."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if not isinstance(obj, dict) or obj.get("type") != "response_item":
                continue
            payload = obj.get("payload")
            if not isinstance(payload, dict) or payload.get("type") != "message":
                continue
            role = payload.get("role")
            if role not in ("user", "assistant"):
                continue
            parts = []
            for item in payload.get("content") or []:
                if isinstance(item, dict) and item.get("type") in ("input_text", "output_text"):
                    text = item.get("text")
                    if isinstance(text, str) and text.strip() \
                            and not text.lstrip().startswith(CODEX_NOISE):
                        parts.append(text)
            if not parts:
                continue
            stamp = obj.get("timestamp")
            when = stamp[:16].replace("T", " ") if isinstance(stamp, str) else ""
            yield {"who": "you" if role == "user" else "codex",
                   "time": when,
                   "text": "\n".join(p.rstrip() for p in parts)}


def iter_pi_turns(path):
    """Same shape, for Pi session files: message lines with
    message.role user/assistant, text items only. Slash commands (/exit,
    /model …) are logged as user messages — machinery, not dialogue."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if not isinstance(obj, dict) or obj.get("type") != "message":
                continue
            message = obj.get("message")
            if not isinstance(message, dict):
                continue
            role = message.get("role")
            if role not in ("user", "assistant"):
                continue
            parts = []
            for item in message.get("content") or []:
                if isinstance(item, dict) and item.get("type") == "text":
                    text = item.get("text")
                    if isinstance(text, str) and text.strip():
                        parts.append(text)
            text = "\n".join(p.rstrip() for p in parts)
            if not text or (role == "user" and text.lstrip().startswith("/")):
                continue
            stamp = obj.get("timestamp")
            when = stamp[:16].replace("T", " ") if isinstance(stamp, str) else ""
            yield {"who": "you" if role == "user" else "pi",
                   "time": when, "text": text}


def antigravity_user_text(content):
    """Unwrap <USER_REQUEST>…</USER_REQUEST>; the rest of the step is
    injected metadata, not something she typed."""
    if not isinstance(content, str):
        return None
    start = content.find("<USER_REQUEST>")
    if start == -1:
        return None
    end = content.find("</USER_REQUEST>", start)
    if end == -1:
        return None
    text = content[start + len("<USER_REQUEST>"):end].strip()
    return text or None


def iter_antigravity_turns(path):
    """Same shape, for Antigravity CLI brain transcripts: step lines with
    {source, type, content}. Dialogue = explicit user inputs and model
    planner responses; checkpoints and history summaries are machinery."""
    with open(path, encoding="utf-8", errors="replace") as fh:
        for line in fh:
            try:
                obj = json.loads(line)
            except ValueError:
                continue
            if not isinstance(obj, dict):
                continue
            source, kind = obj.get("source"), obj.get("type")
            if kind == "USER_INPUT" and source == "USER_EXPLICIT":
                who, text = "you", antigravity_user_text(obj.get("content"))
            elif kind == "PLANNER_RESPONSE" and source == "MODEL":
                text = obj.get("content")
                who = "antigravity"
                if not isinstance(text, str) or not text.strip():
                    text = None
            else:
                continue
            if not text:
                continue
            stamp = obj.get("created_at")
            when = stamp[:16].replace("T", " ") if isinstance(stamp, str) else ""
            yield {"who": who, "time": when, "text": text.rstrip()}


def iter_opencode_turns(path, session_id):
    """Same shape, from OpenCode's SQLite store: one turn per message,
    joining its text parts. `synthetic` parts are injected context, not
    dialogue. sqlite errors surface as OSError so render/preview handle
    every agent the same way."""
    try:
        db = sqlite3.connect("file:%s?mode=ro" % path, uri=True)
    except sqlite3.Error as e:
        raise OSError(str(e))
    try:
        messages = db.execute(
            "SELECT id, data, time_created FROM message"
            " WHERE session_id = ? ORDER BY time_created", (session_id,)).fetchall()
        parts = db.execute(
            "SELECT message_id, data FROM part"
            " WHERE session_id = ? ORDER BY time_created", (session_id,)).fetchall()
    except sqlite3.Error as e:
        raise OSError(str(e))
    finally:
        db.close()

    texts = {}
    for mid, raw in parts:
        try:
            data = json.loads(raw)
        except ValueError:
            continue
        if not isinstance(data, dict) or data.get("type") != "text" \
                or data.get("synthetic"):
            continue
        text = data.get("text")
        if isinstance(text, str) and text.strip() \
                and not text.lstrip().startswith(OPENCODE_NOISE):
            texts.setdefault(mid, []).append(text)

    for mid, raw, created in messages:
        try:
            meta = json.loads(raw)
        except ValueError:
            continue
        role = meta.get("role") if isinstance(meta, dict) else None
        if role not in ("user", "assistant") or mid not in texts:
            continue
        when = datetime.fromtimestamp(
            (created or 0) / 1000.0, tz=timezone.utc).strftime("%Y-%m-%d %H:%M")
        yield {"who": "you" if role == "user" else "opencode",
               "time": when,
               "text": "\n".join(t.rstrip() for t in texts[mid])}


TURN_READERS = {"claude": iter_turns, "codex": iter_codex_turns,
                "opencode": iter_opencode_turns,
                "antigravity": iter_antigravity_turns,
                "pi": iter_pi_turns}
# Readers whose source is a shared store: they need the session id too.
NEEDS_SESSION = ("opencode",)


def clip(text, limit):
    if len(text) <= limit:
        return text
    return text[:limit - 1].rstrip() + "…"


def render(path, out, turns_for=iter_turns):
    try:
        for turn in turns_for(path):
            who = "YOU" if turn["who"] == "you" else turn["who"].upper()
            stamp = " " + turn["time"] if turn["time"] else ""
            out.write("\n───── " + who + stamp + " ─────\n\n")
            out.write(turn["text"] + "\n")
    except OSError as e:
        print("omaconv-render: " + str(e), file=sys.stderr)
        return 1
    return 0


def preview(path, out, clip_chars=PREVIEW_CLIP, turns_for=iter_turns):
    try:
        turns = list(turns_for(path))
    except OSError as e:
        print("omaconv-render: " + str(e), file=sys.stderr)
        return 1
    payload = {"turns": [
        {"who": t["who"], "time": t["time"], "text": clip(t["text"], clip_chars)}
        for t in turns]}
    json.dump(payload, out, ensure_ascii=False)
    out.write("\n")
    return 0


def skill_preview(path, out, clip_chars=PREVIEW_CLIP):
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            text = fh.read()
    except OSError as e:
        print("omaconv-render: " + str(e), file=sys.stderr)
        return 1
    lines = text.splitlines()
    front, body_start = [], 0
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                front = lines[1:i]
                body_start = i + 1
                break
    payload = {"skill": {
        "frontmatter": clip("\n".join(front), clip_chars),
        "body": clip("\n".join(lines[body_start:]).strip("\n"), clip_chars)}}
    json.dump(payload, out, ensure_ascii=False)
    out.write("\n")
    return 0


def usage():
    print("usage: omaconv-render [--preview | --skill] [--agent NAME]"
          " [--session ID] <file>", file=sys.stderr)
    return 2


def _parse_args(args):
    """(mode, options{agent, session}, paths) or None on a bad command line."""
    mode = None
    opts = {"agent": "claude", "session": None}
    paths = []
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("--preview", "--skill"):
            if mode:
                return None
            mode = arg
        elif arg in ("--agent", "--session"):
            i += 1
            if i >= len(args):
                return None
            opts[arg[2:]] = args[i]
        elif arg.startswith("--"):
            return None
        else:
            paths.append(arg)
        i += 1
    return mode, opts, paths


def main(argv):
    parsed = _parse_args(argv[1:])
    if parsed is None:
        return usage()
    mode, opts, paths = parsed
    agent, session = opts["agent"], opts["session"]
    if len(paths) != 1 or agent not in TURN_READERS:
        return usage()
    turns_for = TURN_READERS[agent]
    if agent in NEEDS_SESSION:
        if not session:
            return usage()
        reader = turns_for
        turns_for = lambda p: reader(p, session)
    if mode == "--skill":
        return skill_preview(paths[0], sys.stdout)
    if mode == "--preview":
        return preview(paths[0], sys.stdout, turns_for=turns_for)
    return render(paths[0], sys.stdout, turns_for=turns_for)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
