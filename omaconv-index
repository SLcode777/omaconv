#!/usr/bin/env python3
"""omaconv-index — scans agent session stores and produces the JSON index.

Agents: Claude Code (~/.claude/projects) and Codex (~/.codex/sessions).
Output: ~/.local/state/omaconv/index.json (0600) + stdout.
Incremental: only re-reads files whose mtime or size changed.
Stdlib only. See PRD.md §4-§6.
"""

import argparse
import glob
import json
import os
import sys
from datetime import datetime, timezone

SCHEMA_VERSION = 1
TITLE_MAX = 80


def default_projects_dir():
    return os.path.expanduser("~/.claude/projects")


def default_state_dir():
    return os.path.join(
        os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
        "omaconv",
    )


def default_skills_dir():
    return os.path.expanduser("~/.claude/skills")


def default_sessions_dir():
    return os.path.expanduser("~/.claude/sessions")


def default_codex_dir():
    return os.path.expanduser("~/.codex/sessions")


def scan_running(sessions_dir):
    """sessionId → kind ("interactive", "bg", …) for sessions whose process
    is still alive. State files may be stale after a crash: trust /proc,
    not the file's presence."""
    running = {}
    try:
        entries = os.listdir(sessions_dir)
    except OSError:
        return running
    for name in entries:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(sessions_dir, name), encoding="utf-8") as fh:
                state = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(state, dict):
            continue
        sid = state.get("sessionId")
        pid = state.get("pid")
        if isinstance(sid, str) and isinstance(pid, int) and os.path.exists("/proc/%d" % pid):
            running[sid] = state.get("kind") or "interactive"
    return running


def truncate_title(text):
    text = " ".join(text.split())
    if len(text) <= TITLE_MAX:
        return text
    cut = text[:TITLE_MAX].rsplit(" ", 1)[0]
    return (cut or text[:TITLE_MAX]) + "…"


def _parse_line(line):
    line = line.strip()
    if not line:
        return None
    try:
        obj = json.loads(line)
    except ValueError:
        return None
    return obj if isinstance(obj, dict) else None


def _str_field(obj, *keys):
    for key in keys:
        value = obj.get(key)
        if isinstance(value, str) and value.strip():
            return value
    return None


def _new_state():
    return {
        "customTitle": None,
        "aiTitle": None,
        "prompts": [],
        "cwds": [],
        "gitBranch": None,
        "version": None,
        "lastTimestamp": None,
        "sidechain": False,
        "mainline": False,
    }


def _ingest_user(obj, state):
    cwd = _str_field(obj, "cwd")
    if cwd and cwd not in state["cwds"]:
        state["cwds"].append(cwd)
    branch = _str_field(obj, "gitBranch")
    if branch:
        state["gitBranch"] = branch
    version = _str_field(obj, "version")
    if version:
        state["version"] = version
    side = obj.get("isSidechain")
    if side is True:
        state["sidechain"] = True
    elif side is False:
        state["mainline"] = True


def _ingest(obj, state):
    kind = obj.get("type")
    if kind == "last-prompt":
        prompt = _str_field(obj, "lastPrompt")
        if prompt:
            state["prompts"].append(prompt)
    elif kind == "ai-title":
        title = _str_field(obj, "aiTitle")
        if title:
            state["aiTitle"] = title.strip()
    elif kind == "custom-title":
        title = obj.get("customTitle")
        if isinstance(title, str):
            # Empty string = explicit reset to the auto title (written by
            # omaconv-set-title when the user clears the name).
            state["customTitle"] = title.strip() or None
    elif kind == "user":
        _ingest_user(obj, state)
    ts = _str_field(obj, "timestamp")
    if ts and (state["lastTimestamp"] is None or ts > state["lastTimestamp"]):
        state["lastTimestamp"] = ts


def parse_transcript(path):
    """Extract the useful fields from a .jsonl. Tolerant: an unreadable line
    or a missing field never fails the session (PRD §9)."""
    state = _new_state()
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is not None:
                _ingest(obj, state)
    return {
        "customTitle": state["customTitle"],
        "aiTitle": state["aiTitle"],
        "prompts": state["prompts"],
        "cwds": state["cwds"],
        "gitBranch": state["gitBranch"],
        "version": state["version"],
        "lastTimestamp": state["lastTimestamp"],
        "sidechainOnly": state["sidechain"] and not state["mainline"],
    }


def _pick_title(session_id, parsed):
    if parsed["customTitle"]:
        return parsed["customTitle"], "custom"
    if parsed["aiTitle"]:
        return parsed["aiTitle"], "ai"
    if parsed["prompts"]:
        return truncate_title(parsed["prompts"][0]), "prompt"
    return session_id, "id"


def build_session(path, stat, parsed):
    session_id = os.path.basename(path)[: -len(".jsonl")]
    title, source = _pick_title(session_id, parsed)
    last_activity = parsed["lastTimestamp"] or datetime.fromtimestamp(
        stat.st_mtime, tz=timezone.utc
    ).isoformat()
    return {
        "id": session_id,
        # Reserved for multi-agent support (v2): every parser stamps its
        # agent so the schema never has to break.
        "agent": "claude",
        "title": title,
        "titleSource": source,
        "cwd": parsed["cwds"][0] if parsed["cwds"] else None,
        "cwds": parsed["cwds"],
        "gitBranch": parsed["gitBranch"],
        "version": parsed["version"],
        "lastActivity": last_activity,
        "prompts": parsed["prompts"],
        "transcriptPath": path,
        "sourceMtime": stat.st_mtime,
        "sourceSize": stat.st_size,
        "sidechainOnly": parsed["sidechainOnly"],
    }


def _project_transcripts(project):
    try:
        entries = os.listdir(project)
    except OSError:
        return
    for entry in entries:
        if entry.endswith(".jsonl"):
            full = os.path.join(project, entry)
            if os.path.isfile(full):
                yield full


def list_transcripts(projects_dir):
    """The .jsonl files at the root of each project dir — never the
    subdirectories (subagents/, PRD §9)."""
    paths = []
    try:
        project_dirs = os.listdir(projects_dir)
    except OSError:
        return paths
    for name in project_dirs:
        project = os.path.join(projects_dir, name)
        if os.path.isdir(project):
            paths.extend(_project_transcripts(project))
    return paths


def _session_for(path, cached, parse, build):
    """Reuse the cached entry if mtime and size are unchanged,
    otherwise re-read the transcript with the agent's parser."""
    try:
        stat = os.stat(path)
    except OSError:
        return None
    prev = cached.get(path)
    if (
        prev
        and prev.get("sourceMtime") == stat.st_mtime
        and prev.get("sourceSize") == stat.st_size
    ):
        return prev
    parsed = parse(path)
    if parsed is None:
        return None
    return build(path, stat, parsed)


# --------------------------------------------------------------- codex
# Codex rollouts: sessions/YYYY/MM/DD/rollout-*.jsonl, lines of
# {timestamp, type, payload}. User text lives in response_item messages;
# the leading wrappers below are tooling noise, not something she typed.
CODEX_NOISE = ("<environment_context", "<turn_aborted", "<user_instructions",
               "# Context from my IDE")


def list_codex_rollouts(codex_dir):
    return sorted(glob.glob(os.path.join(codex_dir, "*", "*", "*", "rollout-*.jsonl")))


def codex_user_text(payload):
    parts = []
    for item in payload.get("content") or []:
        if isinstance(item, dict) and item.get("type") == "input_text":
            text = item.get("text")
            if isinstance(text, str) and text.strip():
                parts.append(text)
    text = "\n".join(parts).strip()
    if not text or text.lstrip().startswith(CODEX_NOISE):
        return None
    return text


def _ingest_codex(obj, state):
    kind = obj.get("type")
    payload = obj.get("payload")
    payload = payload if isinstance(payload, dict) else {}
    if kind == "session_meta":
        sid = _str_field(payload, "session_id", "id")
        if sid:
            state["sessionId"] = sid
        git = payload.get("git")
        if isinstance(git, dict):
            branch = _str_field(git, "branch")
            if branch:
                state["gitBranch"] = branch
    if kind in ("session_meta", "turn_context"):
        cwd = _str_field(payload, "cwd")
        if cwd and cwd not in state["cwds"]:
            state["cwds"].append(cwd)
    elif kind == "response_item" and payload.get("type") == "message" \
            and payload.get("role") == "user":
        text = codex_user_text(payload)
        if text:
            state["prompts"].append(text)
    ts = _str_field(obj, "timestamp")
    if ts and (state["lastTimestamp"] is None or ts > state["lastTimestamp"]):
        state["lastTimestamp"] = ts


def parse_codex_transcript(path):
    state = {"sessionId": None, "prompts": [], "cwds": [],
             "gitBranch": None, "lastTimestamp": None}
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is not None:
                _ingest_codex(obj, state)
    return state


def build_codex_session(path, stat, parsed):
    session_id = parsed["sessionId"] or os.path.basename(path)[: -len(".jsonl")]
    title = truncate_title(parsed["prompts"][0]) if parsed["prompts"] else session_id
    last_activity = parsed["lastTimestamp"] or datetime.fromtimestamp(
        stat.st_mtime, tz=timezone.utc
    ).isoformat()
    return {
        "id": session_id,
        "agent": "codex",
        "title": title,
        "titleSource": "prompt" if parsed["prompts"] else "id",
        "cwd": parsed["cwds"][0] if parsed["cwds"] else None,
        "cwds": parsed["cwds"],
        "gitBranch": parsed["gitBranch"],
        "version": None,
        "lastActivity": last_activity,
        "prompts": parsed["prompts"],
        "transcriptPath": path,
        "sourceMtime": stat.st_mtime,
        "sourceSize": stat.st_size,
        "sidechainOnly": False,
    }


def _resume_cwd(session):
    """Where a resume should land. The first cwd (the session's home) when
    it still exists; otherwise the most recent cwd that does — a deliberate
    project move is indistinguishable from tool-driven cd noise in the
    transcript, so the fallback only kicks in when the home is gone.
    Returns (cwd_or_none, is_fallback)."""
    cwds = session.get("cwds") or []
    if cwds and os.path.isdir(cwds[0]):
        return cwds[0], False
    for cwd in reversed(cwds):
        if os.path.isdir(cwd):
            return cwd, True
    return None, False


def scan(projects_dir, previous=None, sessions_dir=None, codex_dir=None):
    """Build the index, incrementally when `previous` (the prior index) is given."""
    running = scan_running(sessions_dir or default_sessions_dir())
    cached = {}
    if previous:
        for session in previous.get("sessions", []):
            if isinstance(session, dict) and session.get("transcriptPath"):
                cached[session["transcriptPath"]] = session

    sources = [
        (list_transcripts(projects_dir), parse_transcript, build_session),
        (list_codex_rollouts(codex_dir if codex_dir is not None else default_codex_dir()),
         parse_codex_transcript, build_codex_session),
    ]
    sessions = []
    for paths, parse, build in sources:
        for path in paths:
            session = _session_for(path, cached, parse, build)
            if session is None or session.get("sidechainOnly"):
                continue
            session["cwdExists"] = bool(session.get("cwd")) and os.path.isdir(session["cwd"])
            session["resumeCwd"], session["cwdFallback"] = _resume_cwd(session)
            session["running"] = running.get(session["id"])
            sessions.append(session)

    sessions.sort(key=lambda s: s.get("lastActivity") or "", reverse=True)
    return {"schemaVersion": SCHEMA_VERSION, "sessions": sessions}


def parse_frontmatter(path):
    """Minimal tolerant YAML-frontmatter reader: top-level `key: value`
    pairs, folded/indented continuation lines appended. No YAML library
    in the stdlib, and skill files only use this subset."""
    fields = {}
    current = None
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return fields
    with fh:
        if fh.readline().strip() != "---":
            return fields
        for line in fh:
            if line.strip() == "---":
                break
            current = _ingest_frontmatter_line(line, fields, current)
    return fields


def _ingest_frontmatter_line(line, fields, current):
    """One line of frontmatter: returns the key continuation lines attach to."""
    if line[:1] in (" ", "\t"):
        cont = line.strip()
        if current and cont:
            fields[current] = (fields[current] + " " + cont).strip()
        return current
    key, sep, value = line.partition(":")
    key = key.strip()
    if not sep or not key or " " in key:
        return None
    value = value.strip().strip("\"'")
    fields[key] = "" if value in (">", "|", ">-", "|-") else value
    return key


def scan_skills(skills_dir):
    """One entry per ~/.claude/skills/<dir>/SKILL.md. Tiny corpus: always
    rescanned in full, no cache."""
    skills = []
    try:
        entries = os.listdir(skills_dir)
    except OSError:
        return skills
    for name in sorted(entries):
        path = os.path.join(skills_dir, name, "SKILL.md")
        if not os.path.isfile(path):
            continue
        fields = parse_frontmatter(path)
        skills.append({
            "name": fields.get("name") or name,
            "description": fields.get("description") or "",
            "path": path,
            # Symlinks resolved: shows where the skill really lives
            # (omarchy system skill vs personal vs project).
            "dir": os.path.dirname(os.path.realpath(path)),
        })
    return skills


def load_cache(state_dir):
    try:
        with open(os.path.join(state_dir, "index.json"), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    if isinstance(data, dict) and data.get("schemaVersion") == SCHEMA_VERSION:
        return data
    return None


def write_cache(state_dir, index):
    """Atomic write, 0600 — the cache holds conversation excerpts (PRD §10)."""
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    target = os.path.join(state_dir, "index.json")
    tmp = target + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(index, fh, ensure_ascii=False)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.replace(tmp, target)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--projects-dir", default=default_projects_dir())
    parser.add_argument("--skills-dir", default=default_skills_dir())
    parser.add_argument("--sessions-dir", default=default_sessions_dir())
    parser.add_argument("--codex-dir", default=default_codex_dir())
    parser.add_argument("--state-dir", default=default_state_dir())
    parser.add_argument("--full", action="store_true", help="ignore the cache, re-read everything")
    parser.add_argument("--quiet", action="store_true", help="write nothing to stdout")
    args = parser.parse_args(argv)

    previous = None if args.full else load_cache(args.state_dir)
    index = scan(args.projects_dir, previous, args.sessions_dir, args.codex_dir)
    index["skills"] = scan_skills(args.skills_dir)
    write_cache(args.state_dir, index)
    if not args.quiet:
        json.dump(index, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
