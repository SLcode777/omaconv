#!/usr/bin/env python3
"""omaconv-index — scans agent session stores and produces the JSON index.

Agents: Claude Code (~/.claude/projects), Codex (~/.codex/sessions),
OpenCode (~/.local/share/opencode/opencode.db), Antigravity CLI
(~/.gemini/antigravity-cli) and Pi (~/.pi/agent/sessions).
Output: ~/.local/state/omaconv/index.json (0600) + stdout.
Incremental: only re-reads files whose mtime or size changed.
Stdlib only. See PRD.md §4-§6.
"""

import argparse
import glob
import json
import os
import re
import sqlite3
import sys
from datetime import datetime, timezone

SCHEMA_VERSION = 1
TITLE_MAX = 80


def default_projects_dir():
    return os.path.expanduser("~/.claude/projects")


def default_state_dir():
    return os.path.join(
        os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")),
        "omaconv",
    )


def default_skills_dir():
    return os.path.expanduser("~/.claude/skills")


def default_sessions_dir():
    return os.path.expanduser("~/.claude/sessions")


def default_codex_dir():
    return os.path.expanduser("~/.codex/sessions")


def scan_running(sessions_dir):
    """sessionId → kind ("interactive", "bg", …) for sessions whose process
    is still alive. State files may be stale after a crash: trust /proc,
    not the file's presence."""
    running = {}
    try:
        entries = os.listdir(sessions_dir)
    except OSError:
        return running
    for name in entries:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(sessions_dir, name), encoding="utf-8") as fh:
                state = json.load(fh)
        except (OSError, ValueError):
            continue
        if not isinstance(state, dict):
            continue
        sid = state.get("sessionId")
        pid = state.get("pid")
        if isinstance(sid, str) and isinstance(pid, int) and os.path.exists("/proc/%d" % pid):
            running[sid] = state.get("kind") or "interactive"
    return running


def truncate_title(text):
    text = " ".join(text.split())
    if len(text) <= TITLE_MAX:
        return text
    cut = text[:TITLE_MAX].rsplit(" ", 1)[0]
    return (cut or text[:TITLE_MAX]) + "…"


def _parse_line(line):
    line = line.strip()
    if not line:
        return None
    try:
        obj = json.loads(line)
    except ValueError:
        return None
    return obj if isinstance(obj, dict) else None


def _str_field(obj, *keys):
    for key in keys:
        value = obj.get(key)
        if isinstance(value, str) and value.strip():
            return value
    return None


def _new_state():
    return {
        "customTitle": None,
        "aiTitle": None,
        "prompts": [],
        "cwds": [],
        "gitBranch": None,
        "version": None,
        "lastTimestamp": None,
        "sidechain": False,
        "mainline": False,
    }


def _ingest_user(obj, state):
    cwd = _str_field(obj, "cwd")
    if cwd and cwd not in state["cwds"]:
        state["cwds"].append(cwd)
    branch = _str_field(obj, "gitBranch")
    if branch:
        state["gitBranch"] = branch
    version = _str_field(obj, "version")
    if version:
        state["version"] = version
    side = obj.get("isSidechain")
    if side is True:
        state["sidechain"] = True
    elif side is False:
        state["mainline"] = True


def _ingest(obj, state):
    kind = obj.get("type")
    if kind == "last-prompt":
        prompt = _str_field(obj, "lastPrompt")
        if prompt:
            state["prompts"].append(prompt)
    elif kind == "ai-title":
        title = _str_field(obj, "aiTitle")
        if title:
            state["aiTitle"] = title.strip()
    elif kind == "custom-title":
        title = obj.get("customTitle")
        if isinstance(title, str):
            # Empty string = explicit reset to the auto title (written by
            # omaconv-set-title when the user clears the name).
            state["customTitle"] = title.strip() or None
    elif kind == "user":
        _ingest_user(obj, state)
    ts = _str_field(obj, "timestamp")
    if ts and (state["lastTimestamp"] is None or ts > state["lastTimestamp"]):
        state["lastTimestamp"] = ts


def parse_transcript(path):
    """Extract the useful fields from a .jsonl. Tolerant: an unreadable line
    or a missing field never fails the session (PRD §9)."""
    state = _new_state()
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is not None:
                _ingest(obj, state)
    return {
        "customTitle": state["customTitle"],
        "aiTitle": state["aiTitle"],
        "prompts": state["prompts"],
        "cwds": state["cwds"],
        "gitBranch": state["gitBranch"],
        "version": state["version"],
        "lastTimestamp": state["lastTimestamp"],
        "sidechainOnly": state["sidechain"] and not state["mainline"],
    }


def _pick_title(session_id, parsed):
    if parsed["customTitle"]:
        return parsed["customTitle"], "custom"
    if parsed["aiTitle"]:
        return parsed["aiTitle"], "ai"
    if parsed["prompts"]:
        return truncate_title(parsed["prompts"][0]), "prompt"
    return session_id, "id"


def build_session(path, stat, parsed):
    session_id = os.path.basename(path)[: -len(".jsonl")]
    title, source = _pick_title(session_id, parsed)
    last_activity = parsed["lastTimestamp"] or datetime.fromtimestamp(
        stat.st_mtime, tz=timezone.utc
    ).isoformat()
    return {
        "id": session_id,
        # Reserved for multi-agent support (v2): every parser stamps its
        # agent so the schema never has to break.
        "agent": "claude",
        "title": title,
        "titleSource": source,
        "cwd": parsed["cwds"][0] if parsed["cwds"] else None,
        "cwds": parsed["cwds"],
        "gitBranch": parsed["gitBranch"],
        "version": parsed["version"],
        "lastActivity": last_activity,
        "prompts": parsed["prompts"],
        "transcriptPath": path,
        "sourceMtime": stat.st_mtime,
        "sourceSize": stat.st_size,
        "sidechainOnly": parsed["sidechainOnly"],
    }


def _project_transcripts(project):
    try:
        entries = os.listdir(project)
    except OSError:
        return
    for entry in entries:
        if entry.endswith(".jsonl"):
            full = os.path.join(project, entry)
            if os.path.isfile(full):
                yield full


def list_transcripts(projects_dir):
    """The .jsonl files at the root of each project dir — never the
    subdirectories (subagents/, PRD §9)."""
    paths = []
    try:
        project_dirs = os.listdir(projects_dir)
    except OSError:
        return paths
    for name in project_dirs:
        project = os.path.join(projects_dir, name)
        if os.path.isdir(project):
            paths.extend(_project_transcripts(project))
    return paths


def _session_for(path, cached, parse, build):
    """Reuse the cached entry if mtime and size are unchanged,
    otherwise re-read the transcript with the agent's parser."""
    try:
        stat = os.stat(path)
    except OSError:
        return None
    prev = cached.get(path)
    if (
        prev
        and prev.get("sourceMtime") == stat.st_mtime
        and prev.get("sourceSize") == stat.st_size
    ):
        return prev
    parsed = parse(path)
    if parsed is None:
        return None
    return build(path, stat, parsed)


# --------------------------------------------------------------- codex
# Codex rollouts: sessions/YYYY/MM/DD/rollout-*.jsonl, lines of
# {timestamp, type, payload}. User text lives in response_item messages;
# the leading wrappers below are tooling noise, not something she typed.
CODEX_NOISE = ("<environment_context", "<turn_aborted", "<user_instructions",
               "# Context from my IDE")


def list_codex_rollouts(codex_dir):
    return sorted(glob.glob(os.path.join(codex_dir, "*", "*", "*", "rollout-*.jsonl")))


def codex_user_text(payload):
    parts = []
    for item in payload.get("content") or []:
        if isinstance(item, dict) and item.get("type") == "input_text":
            text = item.get("text")
            if isinstance(text, str) and text.strip():
                parts.append(text)
    text = "\n".join(parts).strip()
    if not text or text.lstrip().startswith(CODEX_NOISE):
        return None
    return text


def _ingest_codex(obj, state):
    kind = obj.get("type")
    payload = obj.get("payload")
    payload = payload if isinstance(payload, dict) else {}
    if kind == "session_meta":
        sid = _str_field(payload, "session_id", "id")
        if sid:
            state["sessionId"] = sid
        git = payload.get("git")
        if isinstance(git, dict):
            branch = _str_field(git, "branch")
            if branch:
                state["gitBranch"] = branch
    if kind in ("session_meta", "turn_context"):
        cwd = _str_field(payload, "cwd")
        if cwd and cwd not in state["cwds"]:
            state["cwds"].append(cwd)
    elif kind == "response_item" and payload.get("type") == "message" \
            and payload.get("role") == "user":
        text = codex_user_text(payload)
        if text:
            state["prompts"].append(text)
    ts = _str_field(obj, "timestamp")
    if ts and (state["lastTimestamp"] is None or ts > state["lastTimestamp"]):
        state["lastTimestamp"] = ts


def parse_codex_transcript(path):
    state = {"sessionId": None, "prompts": [], "cwds": [],
             "gitBranch": None, "lastTimestamp": None}
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is not None:
                _ingest_codex(obj, state)
    return state


_UUID_TAIL = re.compile(
    r"([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}"
    r"-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\.jsonl$")


def _codex_fallback_id(path):
    """`codex resume` wants a bare UUID; the rollout filename embeds it
    after the timestamp. Whole basename only as a last resort."""
    match = _UUID_TAIL.search(os.path.basename(path))
    return match.group(1) if match else os.path.basename(path)[: -len(".jsonl")]


def build_codex_session(path, stat, parsed):
    session_id = parsed["sessionId"] or _codex_fallback_id(path)
    title = truncate_title(parsed["prompts"][0]) if parsed["prompts"] else session_id
    last_activity = parsed["lastTimestamp"] or datetime.fromtimestamp(
        stat.st_mtime, tz=timezone.utc
    ).isoformat()
    return {
        "id": session_id,
        "agent": "codex",
        "title": title,
        "titleSource": "prompt" if parsed["prompts"] else "id",
        "cwd": parsed["cwds"][0] if parsed["cwds"] else None,
        "cwds": parsed["cwds"],
        "gitBranch": parsed["gitBranch"],
        "version": None,
        "lastActivity": last_activity,
        "prompts": parsed["prompts"],
        "transcriptPath": path,
        "sourceMtime": stat.st_mtime,
        "sourceSize": stat.st_size,
        "sidechainOnly": False,
    }


# ------------------------------------------------------------------ pi
# Pi sessions: one JSONL per session under sessions/<encoded-cwd>/, with a
# header line {type: "session", id, cwd, timestamp} — cwd in plain text.


def default_pi_dir():
    return os.path.expanduser("~/.pi/agent/sessions")


def list_pi_sessions(pi_dir):
    return sorted(glob.glob(os.path.join(pi_dir, "*", "*.jsonl")))


def pi_user_text(message):
    parts = []
    for item in message.get("content") or []:
        if isinstance(item, dict) and item.get("type") == "text":
            text = item.get("text")
            if isinstance(text, str) and text.strip():
                parts.append(text)
    text = "\n".join(parts).strip()
    # Slash commands (/exit, /model …) are logged as user messages.
    if not text or text.startswith("/"):
        return None
    return text


def _ingest_pi(obj, state):
    kind = obj.get("type")
    if kind == "session":
        sid = _str_field(obj, "id")
        if sid:
            state["sessionId"] = sid
        cwd = _str_field(obj, "cwd")
        if cwd and cwd not in state["cwds"]:
            state["cwds"].append(cwd)
    elif kind == "message":
        message = obj.get("message")
        if isinstance(message, dict) and message.get("role") == "user":
            text = pi_user_text(message)
            if text:
                state["prompts"].append(text)
    ts = _str_field(obj, "timestamp")
    if ts and (state["lastTimestamp"] is None or ts > state["lastTimestamp"]):
        state["lastTimestamp"] = ts


def parse_pi_transcript(path):
    state = {"sessionId": None, "prompts": [], "cwds": [], "lastTimestamp": None}
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is not None:
                _ingest_pi(obj, state)
    return state


def build_pi_session(path, stat, parsed):
    session_id = parsed["sessionId"] or os.path.basename(path)[: -len(".jsonl")]
    title = truncate_title(parsed["prompts"][0]) if parsed["prompts"] else session_id
    last_activity = parsed["lastTimestamp"] or datetime.fromtimestamp(
        stat.st_mtime, tz=timezone.utc
    ).isoformat()
    return {
        "id": session_id,
        "agent": "pi",
        "title": title,
        "titleSource": "prompt" if parsed["prompts"] else "id",
        "cwd": parsed["cwds"][0] if parsed["cwds"] else None,
        "cwds": parsed["cwds"],
        "gitBranch": None,
        "version": None,
        "lastActivity": last_activity,
        "prompts": parsed["prompts"],
        "transcriptPath": path,
        "sourceMtime": stat.st_mtime,
        "sourceSize": stat.st_size,
        "sidechainOnly": False,
    }


# --------------------------------------------------------- antigravity
# Antigravity CLI (`agy`): one readable transcript per conversation under
# brain/<id>/.system_generated/logs/transcript.jsonl. The workspace (cwd)
# is not in the transcript — it lives in the CLI's own history.jsonl.


def default_antigravity_dir():
    return os.path.expanduser("~/.gemini/antigravity-cli")


def list_antigravity_transcripts(agy_dir):
    return sorted(glob.glob(os.path.join(
        agy_dir, "brain", "*", ".system_generated", "logs", "transcript.jsonl")))


def antigravity_workspaces(agy_dir):
    """conversationId → workspace dir, from the CLI's prompt history."""
    out = {}
    try:
        fh = open(os.path.join(agy_dir, "history.jsonl"),
                  encoding="utf-8", errors="replace")
    except OSError:
        return out
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is None:
                continue
            cid = _str_field(obj, "conversationId")
            workspace = _str_field(obj, "workspace")
            if cid and workspace:
                out[cid] = workspace
    return out


def antigravity_user_text(content):
    """The text she typed, unwrapped from <USER_REQUEST>…</USER_REQUEST>
    (the rest of the step is injected metadata)."""
    if not isinstance(content, str):
        return None
    start = content.find("<USER_REQUEST>")
    if start == -1:
        return None
    end = content.find("</USER_REQUEST>", start)
    if end == -1:
        return None
    text = content[start + len("<USER_REQUEST>"):end].strip()
    return text or None


def parse_antigravity_transcript(path):
    state = {"prompts": [], "lastTimestamp": None}
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return None
    with fh:
        for line in fh:
            obj = _parse_line(line)
            if obj is None:
                continue
            if obj.get("type") == "USER_INPUT" and obj.get("source") == "USER_EXPLICIT":
                text = antigravity_user_text(obj.get("content"))
                if text:
                    state["prompts"].append(text)
            ts = _str_field(obj, "created_at")
            if ts and (state["lastTimestamp"] is None or ts > state["lastTimestamp"]):
                state["lastTimestamp"] = ts
    return state


def build_antigravity_session(path, stat, parsed, workspaces):
    # …/brain/<conversation-id>/.system_generated/logs/transcript.jsonl
    conv_id = os.path.basename(
        os.path.dirname(os.path.dirname(os.path.dirname(path))))
    title = truncate_title(parsed["prompts"][0]) if parsed["prompts"] else conv_id
    last_activity = parsed["lastTimestamp"] or datetime.fromtimestamp(
        stat.st_mtime, tz=timezone.utc
    ).isoformat()
    cwd = workspaces.get(conv_id)
    return {
        "id": conv_id,
        "agent": "antigravity",
        "title": title,
        "titleSource": "prompt" if parsed["prompts"] else "id",
        "cwd": cwd,
        "cwds": [cwd] if cwd else [],
        "gitBranch": None,
        "version": None,
        "lastActivity": last_activity,
        "prompts": parsed["prompts"],
        "transcriptPath": path,
        "sourceMtime": stat.st_mtime,
        "sourceSize": stat.st_size,
        "sidechainOnly": False,
    }


# ------------------------------------------------------------ opencode
# OpenCode keeps everything in one SQLite db (WAL mode): file stat says
# nothing about which sessions changed, but the two queries below are
# milliseconds even at thousands of sessions — always read fresh.
OPENCODE_NOISE = ("<system-reminder",)
OPENCODE_PLACEHOLDER = "New session - "


def default_opencode_db():
    return os.path.join(
        os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
        "opencode", "opencode.db",
    )


def _opencode_part_text(raw):
    try:
        data = json.loads(raw)
    except ValueError:
        return None
    if not isinstance(data, dict) or data.get("type") != "text":
        return None
    if data.get("synthetic"):  # injected IDE/system context, not typed
        return None
    text = data.get("text")
    if not isinstance(text, str) or not text.strip() \
            or text.lstrip().startswith(OPENCODE_NOISE):
        return None
    return text.strip()


def _opencode_title(title, prompts, session_id):
    if isinstance(title, str) and title.strip() \
            and not title.startswith(OPENCODE_PLACEHOLDER):
        return title.strip(), "ai"
    if prompts:
        return truncate_title(prompts[0]), "prompt"
    return session_id, "id"


def scan_opencode(db_path):
    """One session dict per top-level OpenCode session. Read-only URI so
    a missing db is never created and a running opencode is never locked;
    any sqlite error yields an empty list, not a failed index."""
    if not db_path or not os.path.isfile(db_path):
        return []
    try:
        db = sqlite3.connect("file:%s?mode=ro" % db_path, uri=True)
    except sqlite3.Error:
        return []
    try:
        rows = db.execute(
            "SELECT id, title, directory, time_updated FROM session"
            " WHERE parent_id IS NULL ORDER BY time_updated").fetchall()
        try:
            # json_valid: one hand-corrupted row must not abort the query;
            # and if prompts fail entirely, sessions still get indexed.
            prompt_rows = db.execute(
                "SELECT p.session_id, p.data FROM part p"
                " JOIN message m ON p.message_id = m.id"
                " WHERE json_valid(m.data)"
                " AND json_extract(m.data, '$.role') = 'user'"
                " ORDER BY p.time_created").fetchall()
        except sqlite3.Error:
            prompt_rows = []
    except sqlite3.Error:
        return []
    finally:
        db.close()

    prompts_by_session = {}
    for sid, raw in prompt_rows:
        text = _opencode_part_text(raw)
        if text:
            prompts_by_session.setdefault(sid, []).append(text)

    try:
        stat = os.stat(db_path)
    except OSError:
        return []
    sessions = []
    for sid, title, directory, updated in rows:
        prompts = prompts_by_session.get(sid, [])
        picked, source = _opencode_title(title, prompts, sid)
        cwd = directory if isinstance(directory, str) and directory else None
        # SQLite affinity doesn't guarantee an int, nor a sane magnitude.
        try:
            last = datetime.fromtimestamp(
                updated / 1000.0, tz=timezone.utc).isoformat()
        except (TypeError, ValueError, OverflowError, OSError):
            last = datetime.fromtimestamp(
                stat.st_mtime, tz=timezone.utc).isoformat()
        sessions.append({
            "id": sid,
            "agent": "opencode",
            "title": picked,
            "titleSource": source,
            "cwd": cwd,
            "cwds": [cwd] if cwd else [],
            "gitBranch": None,
            "version": None,
            "lastActivity": last,
            "prompts": prompts,
            # The shared db, not a per-session file: preview passes the
            # session id alongside, delete/rename are capability-gated off.
            "transcriptPath": db_path,
            "sourceMtime": stat.st_mtime,
            "sourceSize": stat.st_size,
            "sidechainOnly": False,
        })
    return sessions


def _resume_cwd(session):
    """Where a resume should land. The first cwd (the session's home) when
    it still exists; otherwise the most recent cwd that does — a deliberate
    project move is indistinguishable from tool-driven cd noise in the
    transcript, so the fallback only kicks in when the home is gone.
    Returns (cwd_or_none, is_fallback)."""
    cwds = session.get("cwds") or []
    if cwds and os.path.isdir(cwds[0]):
        return cwds[0], False
    for cwd in reversed(cwds):
        if os.path.isdir(cwd):
            return cwd, True
    return None, False


def _admit(session, sessions, running):
    if session is None or session.get("sidechainOnly"):
        return
    session["cwdExists"] = bool(session.get("cwd")) and os.path.isdir(session["cwd"])
    session["resumeCwd"], session["cwdFallback"] = _resume_cwd(session)
    session["running"] = running.get(session["id"])
    sessions.append(session)


def scan(projects_dir, previous=None, sessions_dir=None, codex_dir=None,
         opencode_db=None, antigravity_dir=None, pi_dir=None):
    """Build the index, incrementally when `previous` (the prior index) is given."""
    running = scan_running(sessions_dir or default_sessions_dir())
    cached = {}
    if previous:
        for session in previous.get("sessions", []):
            # OpenCode sessions all share the db path — they are always
            # re-queried, never cached per file.
            if isinstance(session, dict) and session.get("transcriptPath") \
                    and session.get("agent") != "opencode":
                cached[session["transcriptPath"]] = session

    agy_dir = antigravity_dir if antigravity_dir is not None else default_antigravity_dir()
    agy_workspaces = antigravity_workspaces(agy_dir)
    sources = [
        (list_transcripts(projects_dir), parse_transcript, build_session),
        (list_codex_rollouts(codex_dir if codex_dir is not None else default_codex_dir()),
         parse_codex_transcript, build_codex_session),
        (list_antigravity_transcripts(agy_dir), parse_antigravity_transcript,
         lambda p, st, parsed: build_antigravity_session(p, st, parsed, agy_workspaces)),
        (list_pi_sessions(pi_dir if pi_dir is not None else default_pi_dir()),
         parse_pi_transcript, build_pi_session),
    ]
    sessions = []
    for paths, parse, build in sources:
        for path in paths:
            _admit(_session_for(path, cached, parse, build), sessions, running)
    db_path = opencode_db if opencode_db is not None else default_opencode_db()
    for session in scan_opencode(db_path):
        _admit(session, sessions, running)

    sessions.sort(key=lambda s: s.get("lastActivity") or "", reverse=True)
    return {"schemaVersion": SCHEMA_VERSION, "sessions": sessions}


def parse_frontmatter(path):
    """Minimal tolerant YAML-frontmatter reader: top-level `key: value`
    pairs, folded/indented continuation lines appended. No YAML library
    in the stdlib, and skill files only use this subset."""
    fields = {}
    current = None
    try:
        fh = open(path, encoding="utf-8", errors="replace")
    except OSError:
        return fields
    with fh:
        if fh.readline().strip() != "---":
            return fields
        for line in fh:
            if line.strip() == "---":
                break
            current = _ingest_frontmatter_line(line, fields, current)
    return fields


def _ingest_frontmatter_line(line, fields, current):
    """One line of frontmatter: returns the key continuation lines attach to."""
    if line[:1] in (" ", "\t"):
        cont = line.strip()
        if current and cont:
            fields[current] = (fields[current] + " " + cont).strip()
        return current
    key, sep, value = line.partition(":")
    key = key.strip()
    if not sep or not key or " " in key:
        return None
    value = value.strip().strip("\"'")
    fields[key] = "" if value in (">", "|", ">-", "|-") else value
    return key


def scan_skills(skills_dir):
    """One entry per ~/.claude/skills/<dir>/SKILL.md. Tiny corpus: always
    rescanned in full, no cache."""
    skills = []
    try:
        entries = os.listdir(skills_dir)
    except OSError:
        return skills
    for name in sorted(entries):
        path = os.path.join(skills_dir, name, "SKILL.md")
        if not os.path.isfile(path):
            continue
        fields = parse_frontmatter(path)
        skills.append({
            "name": fields.get("name") or name,
            "description": fields.get("description") or "",
            "path": path,
            # Symlinks resolved: shows where the skill really lives
            # (omarchy system skill vs personal vs project).
            "dir": os.path.dirname(os.path.realpath(path)),
        })
    return skills


def load_cache(state_dir):
    try:
        with open(os.path.join(state_dir, "index.json"), encoding="utf-8") as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return None
    if isinstance(data, dict) and data.get("schemaVersion") == SCHEMA_VERSION:
        return data
    return None


def write_cache(state_dir, index):
    """Atomic write, 0600 — the cache holds conversation excerpts (PRD §10)."""
    os.makedirs(state_dir, mode=0o700, exist_ok=True)
    target = os.path.join(state_dir, "index.json")
    tmp = target + ".tmp"
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            json.dump(index, fh, ensure_ascii=False)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    os.replace(tmp, target)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--projects-dir", default=default_projects_dir())
    parser.add_argument("--skills-dir", default=default_skills_dir())
    parser.add_argument("--sessions-dir", default=default_sessions_dir())
    parser.add_argument("--codex-dir", default=default_codex_dir())
    parser.add_argument("--opencode-db", default=default_opencode_db())
    parser.add_argument("--antigravity-dir", default=default_antigravity_dir())
    parser.add_argument("--pi-dir", default=default_pi_dir())
    parser.add_argument("--state-dir", default=default_state_dir())
    parser.add_argument("--full", action="store_true", help="ignore the cache, re-read everything")
    parser.add_argument("--quiet", action="store_true", help="write nothing to stdout")
    args = parser.parse_args(argv)

    previous = None if args.full else load_cache(args.state_dir)
    index = scan(args.projects_dir, previous, args.sessions_dir, args.codex_dir,
                 args.opencode_db, args.antigravity_dir, args.pi_dir)
    index["skills"] = scan_skills(args.skills_dir)
    write_cache(args.state_dir, index)
    if not args.quiet:
        json.dump(index, sys.stdout, ensure_ascii=False)
        sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
